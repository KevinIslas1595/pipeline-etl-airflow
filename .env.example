# Opcional: copia este archivo como ".env" para cambiar los valores por defecto.
# Sin .env, docker compose usa exactamente estos valores.

# Usuario de la interfaz web de Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Usuario del data warehouse PostgreSQL (localhost:5433, base dulceria_dw)
DW_USUARIO=dulceria
DW_CLAVE=dulceria

# Usuario con el que corren los contenedores de Airflow
AIRFLOW_UID=50000
